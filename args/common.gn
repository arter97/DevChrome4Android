# GN args shared by all build variants (see args/<variant>.gn).
target_os = "android"
target_cpu = "arm64"

is_debug = false
is_component_build = false
dcheck_always_on = false
symbol_level = 0
blink_symbol_level = 0
v8_symbol_level = 0

chrome_public_manifest_package = "com.arter97.devchrome"

proprietary_codecs = true
ffmpeg_branding = "Chrome"

use_remoteexec = false
disable_android_lint = true
