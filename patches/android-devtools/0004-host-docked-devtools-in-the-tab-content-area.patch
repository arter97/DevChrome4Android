+
+/**
+ * Hosts the DevTools frontend docked into the current tab of a {@link CompositorViewHolder}.
+ *
+ * <p>Like on desktop, the DevTools {@link WebContents} covers the content area of the tab and the
+ * inspected contents are placed on top of it, at the bounds requested by the DevTools frontend. The
+ * compositor draws the DevTools frontend behind the tab (see StaticTabSceneLayer), while input is
+ * routed to the frontend through a {@link ContentView} placed over the content area that lets input
+ * over the inspected contents pass through to the tab.
+ */
+@NullMarked
+class DockedDevToolsHost implements DevToolsDock.Observer {
+    private final CompositorViewHolder mHolder;
+    private final WindowAndroid mWindowAndroid;
+    private final Container mContainer;
+    // ContentViews of DevTools frontends, kept while the inspected tab is in the background.
+    private final Map<WebContents, ContentView> mContentViews = new WeakHashMap<>();
+    private final RectF mCacheViewport = new RectF();
+
+    private @Nullable WebContents mInspectedWebContents;
+    private @Nullable WebContents mDevToolsWebContents;
+    private @Nullable ContentView mDevToolsContentView;
+    private @Nullable BrowserControlsManager mBrowserControlsManager;
+    private int mBrowserControlsToken = TokenHolder.INVALID_TOKEN;
+
+    /** Bounds of the inspected contents relative to the DevTools content view. */
+    private final Rect mInspectedBounds = new Rect();
+
+    /**
+     * Holds the DevTools {@link ContentView} and lets input outside of it, or over the inspected
+     * contents, pass through to the views below (i.e. the tab).
+     */
+    private class Container extends FrameLayout {
+        private boolean mPassingThroughTouch;
+
+        Container(Context context) {
+            super(context);
+        }
+
+        private boolean shouldPassThrough(MotionEvent e) {
+            View view = mDevToolsContentView;
+            if (view == null) return true;
+            int x = (int) e.getX() - view.getLeft();
+            int y = (int) e.getY() - view.getTop();
+            if (x < 0 || y < 0 || x >= view.getWidth() || y >= view.getHeight()) return true;
+            return mInspectedBounds.contains(x, y);
+        }
+
+        @Override
+        public boolean dispatchTouchEvent(MotionEvent e) {
+            if (e.getActionMasked() == MotionEvent.ACTION_DOWN) {
+                mPassingThroughTouch = shouldPassThrough(e);
+                View focusTarget = mPassingThroughTouch ? mHolder.getContentView() : null;
+                if (!mPassingThroughTouch) focusTarget = mDevToolsContentView;
+                if (focusTarget != null && !focusTarget.hasFocus()) focusTarget.requestFocus();
+            }
+            if (mPassingThroughTouch) return false;
+            return super.dispatchTouchEvent(e);
+        }
+
+        @Override
+        public boolean dispatchGenericMotionEvent(MotionEvent e) {
+            if (e.isFromSource(InputDevice.SOURCE_CLASS_POINTER) && shouldPassThrough(e)) {
+                return false;
+            }
+            return super.dispatchGenericMotionEvent(e);
+        }
+
+        @Override
+        protected boolean dispatchHoverEvent(MotionEvent e) {
+            if (shouldPassThrough(e)) return false;
+            return super.dispatchHoverEvent(e);
+        }
+    }
+
+    DockedDevToolsHost(CompositorViewHolder holder, WindowAndroid windowAndroid) {
+        mHolder = holder;
+        mWindowAndroid = windowAndroid;
+        mContainer = new Container(holder.getContext());
+        mContainer.setVisibility(View.GONE);
+        DevToolsDock.addObserver(this);
+    }
+
+    void setBrowserControlsManager(@Nullable BrowserControlsManager manager) {
+        releaseBrowserControls();
+        mBrowserControlsManager = manager;
+        if (mDevToolsWebContents != null) pinBrowserControls();
+    }
+
+    void destroy() {
+        DevToolsDock.removeObserver(this);
+        setDockedDevTools(null, null);
+        mContentViews.clear();
+    }
+
+    /** The container that has to be added on top of the tab's view. */
+    View getContainerView() {
+        return mContainer;
+    }
+
+    /** Returns the offset of the inspected contents relative to the content area. */
+    int getInspectedContentsOffsetX() {
+        return mDevToolsWebContents != null ? mInspectedBounds.left : 0;
+    }
+
+    /** Returns the offset of the inspected contents relative to the content area. */
+    int getInspectedContentsOffsetY() {
+        return mDevToolsWebContents != null ? mInspectedBounds.top : 0;
+    }
+
+    /**
+     * Shows the DevTools docked into the given tab, if any, and hides any other docked DevTools.
+     *
+     * @param tab The tab currently shown in the content area, or null if no tab is shown.
+     * @return Whether the docked DevTools changed.
+     */
+    boolean update(@Nullable Tab tab) {
+        WebContents inspectedWebContents = tab != null ? tab.getWebContents() : null;
+        WebContents devToolsWebContents = null;
+        if (inspectedWebContents != null && !inspectedWebContents.isDestroyed()) {
+            devToolsWebContents = DevToolsDock.getDockedDevToolsWebContents(inspectedWebContents);
+        }
+        if (devToolsWebContents == null) inspectedWebContents = null;
+        if (inspectedWebContents == mInspectedWebContents
+                && devToolsWebContents == mDevToolsWebContents) {
+            return false;
+        }
+        setDockedDevTools(inspectedWebContents, devToolsWebContents);
+        return true;
+    }
+
+    private void setDockedDevTools(
+            @Nullable WebContents inspectedWebContents,
+            @Nullable WebContents devToolsWebContents) {
+        if (mDevToolsWebContents != null) {
+            if (mDevToolsContentView != null) mContainer.removeView(mDevToolsContentView);
+            if (!mDevToolsWebContents.isDestroyed()) {
+                mDevToolsWebContents.updateWebContentsVisibility(Visibility.HIDDEN);
+            }
+            releaseBrowserControls();
+        }
+
+        mInspectedWebContents = inspectedWebContents;
+        mDevToolsWebContents = devToolsWebContents;
+        mDevToolsContentView = null;
+        mInspectedBounds.setEmpty();
+
+        LayoutManagerImpl layoutManager = mHolder.getLayoutManager();
+        if (devToolsWebContents == null) {
+            mContainer.setVisibility(View.GONE);
+            if (layoutManager != null) layoutManager.setDockedDevTools(null, null);
+            return;
+        }
+
+        ContentView contentView = mContentViews.get(devToolsWebContents);
+        if (contentView == null) {
+            contentView = ContentView.createContentView(mHolder.getContext(), devToolsWebContents);
+            devToolsWebContents.setDelegates(
+                    VersionInfo.getProductVersion(),
+                    ViewAndroidDelegate.createBasicDelegate(contentView),
+                    contentView,
+                    mWindowAndroid,
+                    WebContents.createDefaultInternalsHolder());
+            mContentViews.put(devToolsWebContents, contentView);
+        }
+        mDevToolsContentView = contentView;
+        mContainer.addView(
+                contentView,
+                new FrameLayout.LayoutParams(
+                        FrameLayout.LayoutParams.MATCH_PARENT,
+                        FrameLayout.LayoutParams.MATCH_PARENT));
+        mContainer.setVisibility(View.VISIBLE);
+        devToolsWebContents.updateWebContentsVisibility(Visibility.VISIBLE);
+        // Keep the content area still while DevTools are docked into it.
+        pinBrowserControls();
+    }
+
+    /**
+     * Lays out the docked DevTools of the given tab's contents within the content area.
+     *
+     * @param inspectedWebContents The {@link WebContents} of the tab being laid out.
+     * @param width The width of the content area in px.
+     * @param height The height of the content area in px.
+     * @return The bounds of the inspected contents relative to the content area, or null if no
+     *     DevTools are docked into {@code inspectedWebContents}.
+     */
+    @Nullable Rect layout(WebContents inspectedWebContents, int width, int height) {
+        WebContents devToolsWebContents = mDevToolsWebContents;
+        ContentView contentView = mDevToolsContentView;
+        if (devToolsWebContents == null
+                || contentView == null
+                || inspectedWebContents != mInspectedWebContents
+                || devToolsWebContents.isDestroyed()) {
+            return null;
+        }
+
+        // The DevTools frontend covers the whole content area.
+        mHolder.getVisibleViewport(mCacheViewport);
+        FrameLayout.LayoutParams params = (FrameLayout.LayoutParams) contentView.getLayoutParams();
+        int left = Math.round(mCacheViewport.left);
+        int top = Math.round(mCacheViewport.top);
+        if (params.width != width
+                || params.height != height
+                || params.leftMargin != left
+                || params.topMargin != top) {
+            params.width = width;
+            params.height = height;
+            params.leftMargin = left;
+            params.topMargin = top;
+            contentView.setLayoutParams(params);
+        }
+        mHolder.getCompositorView()
+                .onPhysicalBackingSizeChanged(devToolsWebContents, width, height);
+        devToolsWebContents.setSize(width, height);
+
+        float dipScale = mWindowAndroid.getDisplay().getDipScale();
+        Rect bounds =
+                DevToolsDock.getInspectedContentsBounds(
+                        inspectedWebContents, width, height, dipScale);
+        mInspectedBounds.set(bounds);
+
+        LayoutManagerImpl layoutManager = mHolder.getLayoutManager();
+        if (layoutManager != null) {
+            layoutManager.setDockedDevTools(devToolsWebContents, new Rect(bounds));
+        }
+        return bounds;
+    }
+
+    private void pinBrowserControls() {
+        if (mBrowserControlsManager == null) return;
+        mBrowserControlsToken =
+                mBrowserControlsManager
+                        .getBrowserVisibilityDelegate()
+                        .showControlsPersistentAndClearOldToken(mBrowserControlsToken);
+    }
+
+    private void releaseBrowserControls() {
+        if (mBrowserControlsManager == null) return;
+        mBrowserControlsManager
+                .getBrowserVisibilityDelegate()
+                .releasePersistentShowingToken(mBrowserControlsToken);
+        mBrowserControlsToken = TokenHolder.INVALID_TOKEN;
+    }
+
+    // DevToolsDock.Observer implementation.
+
+    @Override
+    public void onDockedDevToolsChanged(WebContents inspectedWebContents) {
+        WebContents current = mHolder.getWebContents();
+        if (inspectedWebContents != current && inspectedWebContents != mInspectedWebContents) {
+            return;
+        }
+        mHolder.onDockedDevToolsChanged();
+    }
+}
