+    if (docked_devtools_layer_ &&
+        docked_devtools_layer_->parent() == layer_.get()) {
+      docked_devtools_layer_->RemoveFromParent();
+    }
+    docked_devtools_layer_ = devtools_layer;
+    if (docked_devtools_layer_) {
+      // Behind the tab's contents.
+      layer_->InsertChild(docked_devtools_layer_, 0);
+    }
+  }
+  if (!docked_devtools_layer_) {
+    return;
+  }
+
+  docked_devtools_layer_->SetPosition(gfx::PointF(x, y));
+  docked_devtools_layer_->SetOffsetTag(
+      cc::android::FromJavaOffsetTag(env, joffset_tag));
