+++ b/chrome/browser/devtools/android/java/src/org/chromium/chrome/browser/devtools/DevToolsDock.java
@@ -0,0 +1,92 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.devtools;
+
+import android.graphics.Rect;
+
+import org.jni_zero.CalledByNative;
+import org.jni_zero.JniType;
+import org.jni_zero.NativeMethods;
+
+import org.chromium.base.ObserverList;
+import org.chromium.base.ThreadUtils;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.content_public.browser.WebContents;
+
+/**
+ * Exposes DevTools that are docked into an inspected tab to the Java UI, which lays out the
+ * DevTools frontend and the inspected contents within the tab's content area.
+ *
+ * <p>Like on desktop, the DevTools frontend covers the whole content area and the inspected
+ * contents are placed on top of it, at the bounds requested by the frontend. This allows the
+ * frontend to implement all dock sides as well as the device mode toolbar by itself.
+ */
+@NullMarked
+public final class DevToolsDock {
+    /** Observes changes of docked DevTools. */
+    public interface Observer {
+        /**
+         * Called when DevTools docked into {@code inspectedWebContents} were opened, closed or
+         * requested new bounds for the inspected contents.
+         */
+        void onDockedDevToolsChanged(WebContents inspectedWebContents);
+    }
+
+    private static final ObserverList<Observer> sObservers = new ObserverList<>();
+
+    private DevToolsDock() {}
+
+    public static void addObserver(Observer observer) {
+        ThreadUtils.assertOnUiThread();
+        sObservers.addObserver(observer);
+    }
+
+    public static void removeObserver(Observer observer) {
+        ThreadUtils.assertOnUiThread();
+        sObservers.removeObserver(observer);
+    }
+
+    /** Returns the DevTools frontend docked into {@code inspectedWebContents}, if any. */
+    public static @Nullable WebContents getDockedDevToolsWebContents(
+            WebContents inspectedWebContents) {
+        return DevToolsDockJni.get().getDockedDevToolsWebContents(inspectedWebContents);
+    }
+
+    /**
+     * Returns the bounds of the inspected contents within the DevTools container.
+     *
+     * @param inspectedWebContents The inspected {@link WebContents}.
+     * @param width The width of the DevTools container in px.
+     * @param height The height of the DevTools container in px.
+     * @param dipScale The device scale factor.
+     * @return The bounds in px relative to the container. Empty if the inspected contents should
+     *     be hidden.
+     */
+    public static Rect getInspectedContentsBounds(
+            WebContents inspectedWebContents, int width, int height, float dipScale) {
+        int[] bounds =
+                DevToolsDockJni.get()
+                        .getInspectedContentsBounds(inspectedWebContents, width, height, dipScale);
+        return new Rect(
+                bounds[0], bounds[1], bounds[0] + bounds[2], bounds[1] + bounds[3]);
+    }
+
+    @CalledByNative
+    private static void onDockedDevToolsChanged(WebContents inspectedWebContents) {
+        for (Observer observer : sObservers) {
+            observer.onDockedDevToolsChanged(inspectedWebContents);
+        }
+    }
+
+    @NativeMethods
+    interface Natives {
+        @Nullable WebContents getDockedDevToolsWebContents(WebContents inspectedWebContents);
+
+        @JniType("std::vector<int32_t>")
+        int[] getInspectedContentsBounds(
+                WebContents inspectedWebContents, int width, int height, float dipScale);
+    }
+}
