 void DevToolsWindow::UpdateBrowserWindow() {
-  NOTIMPLEMENTED();
+  // Docked DevTools are laid out by the Java embedder (see DevToolsDock.java),
+  // which queries the current state through GetInTabWebContents().
+  WebContents* inspected_web_contents = GetInspectedWebContents();
+  if (!inspected_web_contents) {
+    return;
+  }
+  Java_DevToolsDock_onDockedDevToolsChanged(
+      jni_zero::AttachCurrentThread(),
+      inspected_web_contents->GetJavaWebContents());
+}
+
+static jni_zero::ScopedJavaLocalRef<jobject>
+JNI_DevToolsDock_GetDockedDevToolsWebContents(
+    JNIEnv* env,
+    const jni_zero::JavaRef<jobject>& java_inspected_web_contents) {
+  WebContents* inspected_web_contents =
+      WebContents::FromJavaWebContents(java_inspected_web_contents);
+  if (!inspected_web_contents) {
+    return nullptr;
+  }
+  WebContents* devtools_web_contents =
+      DevToolsWindow::GetInTabWebContents(inspected_web_contents, nullptr);
+  if (!devtools_web_contents ||
+      !DevToolsWindow::IsDevToolsWindow(devtools_web_contents)) {
+    return nullptr;
+  }
+  return devtools_web_contents->GetJavaWebContents();
 }
+
+// Returns {x, y, width, height} of the inspected contents in physical pixels
+// within a DevTools container of |width| x |height| physical pixels. An empty
+// size means the inspected contents should be hidden.
+static std::vector<int32_t> JNI_DevToolsDock_GetInspectedContentsBounds(
+    JNIEnv* env,
+    const jni_zero::JavaRef<jobject>& java_inspected_web_contents,
+    int32_t width,
+    int32_t height,
+    float dip_scale) {
+  WebContents* inspected_web_contents =
+      WebContents::FromJavaWebContents(java_inspected_web_contents);
+  DevToolsContentsResizingStrategy strategy;
+  if (!inspected_web_contents ||
+      !DevToolsWindow::GetInTabWebContents(inspected_web_contents,
+                                           &strategy)) {
+    return {0, 0, width, height};
+  }
+
+  // The frontend reports the inspected page bounds in DIPs.
+  gfx::Rect container(
+      gfx::ScaleToFlooredSize(gfx::Size(width, height), 1.f / dip_scale));
+  gfx::Rect devtools_bounds;
+  gfx::Rect contents_bounds;
+  ApplyDevToolsContentsResizingStrategy(strategy, container, &devtools_bounds,
+                                        &contents_bounds);
+  gfx::Rect bounds = gfx::ScaleToRoundedRect(contents_bounds, dip_scale);
+  bounds.Intersect(gfx::Rect(width, height));
+  return {bounds.x(), bounds.y(), bounds.width(), bounds.height()};
+}
+
+DEFINE_JNI(DevToolsDock)
